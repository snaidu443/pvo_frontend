# Copy to .env.local and adjust. Never commit real secrets: PVO_* values are bundled into the browser build.

# "mock" = JSON files in src/mocks/data (default). "api" = call the FastAPI backend.
PVO_DATA_SOURCE=mock

# Base URL of the FastAPI backend, used only when PVO_DATA_SOURCE=api. Example: https://pvo-api.example.com/api/v1
PVO_API_BASE_URL=

# Simulated network delay for mock mode, in milliseconds.
PVO_MOCK_LATENCY_MS=150
