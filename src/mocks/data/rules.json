    "id": "R-IRA-01",
    "code": "IRA-ELIG-01",
    "name": "IRA negotiation eligibility",
    "policy": "IRA",
    "category": "eligibility",
    "description": "Determines whether an asset meets the current IRA selection gates.",
    "plainEnglishLogic": "An asset is in scope when its Medicare spend exceeds the threshold, it has an eligible non-orphan indication, and no generic entry precedes selection.",
    "formalLogic": "spend > 200M AND non_orphan_indication AND generic_entry_year > selection_year",
    "inputFields": [
      "annual_medicare_spend",
      "orphan_status",
      "generic_entry_year",
      "modality"
    ],
    "outputFields": [
      "ira_eligibility",
      "selection_year"
    ],
    "status": "active",
    "version": "3.2",
